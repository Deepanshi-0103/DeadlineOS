# Neon PostgreSQL
# Pooled URL for the app (add -pooler to the host from Neon Console → Connect)
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Direct URL for Prisma CLI (migrate / db push) — no -pooler
DIRECT_URL="postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require"

# JWT session secret — use a long random string in production
JWT_SECRET="change-me-to-a-long-random-secret"

# ── Phase D: LLM extraction ──────────────────────────────────────────────────
LLM_EXTRACTION_ENABLED="true"

# gemini (free tier) | openai
LLM_PROVIDER="gemini"

# Google AI Studio key — https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-flash-latest"

# Plan My Day: Gemini tool calling (auto-on if LLM_EXTRACTION_ENABLED + key; set false to force rules)
LLM_PLAN_ENABLED="true"

# Optional OpenAI fallback (only used when LLM_PROVIDER=openai)
OPENAI_API_KEY="sk-..."

# App public URL (used for Google OAuth redirect)
APP_URL="http://localhost:3000"

# ── Google Calendar (one-way: DeadlineOS → Google) ───────────────────────────
# Create OAuth client: https://console.cloud.google.com/apis/credentials
# Enable "Google Calendar API", add redirect URI: {APP_URL}/api/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional override (defaults to {APP_URL}/api/google/callback)
# GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"
